rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function role() { return request.auth.token.role; }

    // Adjuntos de correos recibidos: solo lectura, supervisor o el asesor dueño del caso
    match /incoming/{emailId}/{file} {
      allow read: if request.auth != null && (
        role() == 'supervisor' ||
        (role() == 'advisor' &&
          firestore.get(/databases/(default)/documents/incoming_emails/$(emailId)).data.assignedTo == request.auth.uid)
      );
      allow write: if false; // solo la Cloud Function
    }

    // Adjuntos que el asesor sube para una respuesta (máx. 10 MB por archivo)
    match /reply_attachments/{emailId}/{file} {
      allow create: if request.auth != null
                    && (role() == 'supervisor' || role() == 'advisor')
                    && request.resource.size < 10 * 1024 * 1024;
      allow read, update, delete: if false;
    }
  }
}
